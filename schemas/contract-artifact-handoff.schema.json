{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ReptilianHQ/launch-on-block-sdk/blob/main/schemas/contract-artifact-handoff.schema.json",
  "title": "Launch On Block contract artifact handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "producerId",
    "releaseId",
    "chainId",
    "deploymentId",
    "startBlock",
    "abiRevision",
    "artifacts",
    "signature"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "producerId": { "const": "launch-on-block-contracts" },
    "releaseId": { "type": "string", "pattern": "^[0-9A-Za-z][0-9A-Za-z._-]*$" },
    "chainId": { "type": "integer", "minimum": 1 },
    "deploymentId": { "type": "string", "pattern": "^[1-9][0-9]*:launchpad:0x[0-9a-f]{40}:[0-9]+$" },
    "startBlock": { "type": "integer", "minimum": 0 },
    "abiRevision": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "artifacts": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "contentBase64"],
        "properties": {
          "path": { "enum": ["src/generated/abis.ts", "src/generated/deployments.ts"] },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "contentBase64": { "type": "string", "minLength": 1 }
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "keyId", "valueBase64"],
      "properties": {
        "algorithm": { "const": "Ed25519" },
        "keyId": { "type": "string", "pattern": "^[0-9A-Za-z][0-9A-Za-z._-]*$" },
        "valueBase64": { "type": "string", "minLength": 1 }
      }
    }
  }
}
